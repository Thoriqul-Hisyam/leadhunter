APP_NAME="LeadHunter AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=leadhunter
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Harus lebih besar dari timeout job scraping (900 detik)
DB_QUEUE_RETRY_AFTER=1000

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Koneksi email (SMTP Gmail) diatur di halaman Pengaturan (disimpan di database).
# MAIL_MAILER hanya dipakai jika mode kirim belum dipilih di Pengaturan.
MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (URL, API key, model) diatur di halaman Pengaturan. Di sini hanya batas waktu & retry.
AI_TIMEOUT=120
AI_RETRIES=2

# Scraper: puppeteer (gratis) | google_places | apify
SCRAPER_DRIVER=puppeteer
SCRAPER_MAX_RESULTS=100
SCRAPER_TIMEOUT=840
GOOGLE_PLACES_API_KEY=
APIFY_TOKEN=

# Node & Chrome untuk Puppeteer (kosongkan jika "node" ada di PATH dan Chrome terpasang di lokasi standar)
NODE_BINARY=node
CHROME_PATH=

# Pengiriman email outreach (batas aman Gmail ~20/jam)
OUTREACH_HOURLY_LIMIT=20
OUTREACH_MIN_GAP_SECONDS=90
OUTREACH_MAX_GAP_SECONDS=240
OUTREACH_MAX_ATTEMPTS=3

# Deteksi reply otomatis via IMAP: aktifkan di halaman Pengaturan (memakai akun Gmail SMTP yang sama)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_ENCRYPTION=ssl

# Password admin default saat db:seed (ganti sebelum deploy)
ADMIN_PASSWORD=admin123
